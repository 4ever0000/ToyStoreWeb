@inherits LayoutComponentBase
@using ToyStore.Frontend.Pages
@using ToyStore.Frontend.Services
@using ToyStore.Frontend.Models
@inject CartService CartService
@inject WishlistService WishlistService
@inject ThemeService ThemeService
@inject HttpClient Http
@inject NavigationManager NavManager
@implements IDisposable

<div class="page">
    <main>
        <!-- 📱 ÜST MENYU (Navbar) -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-lg py-3 sticky-top">
            <div class="container px-lg-5">
                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-3 d-flex align-items-center" href="/">
                    <span class="me-2">🧸</span> ToyStore
                </a>
                
                <!-- Mobil üçün Burger Menyu -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menyu Linkləri -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    
                    <!-- 🔍 CANLI AXTARIŞ (Navbar-ın ortasında) 🔍 -->
                    <div class="mx-auto position-relative search-box-container my-3 my-lg-0" style="width: 300px;">
                        <div class="input-group input-group-sm bg-white rounded-pill overflow-hidden border-0 shadow-sm">
                            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-0 shadow-none text-dark" 
                                   placeholder="Oyuncaq axtar..." 
                                   @bind="searchText" 
                                   @oninput="HandleSearchInput" />
                        </div>

                        <!-- Axtarış Dropdown -->
                        @if (searchResults != null && searchResults.Any())
                        {
                            <div class="global-search-dropdown shadow-lg rounded-3 border animate__animated animate__fadeIn">
                                @foreach (var p in searchResults)
                                {
                                    <div class="search-item-row" @onclick="() => SelectProduct(p.Id)">
                                        <img src="@p.ImageUrl" alt="@p.Name" />
                                        <div class="text-truncate">
                                            <div class="fw-bold small text-dark text-truncate">@p.Name</div>
                                            <div class="text-success fw-bold" style="font-size: 0.75rem;">@p.Price.ToString("0.00") AZN</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="navbar-nav ms-auto align-items-center gap-2">
                        <NavLink class="nav-link px-3" href="/" Match="NavLinkMatch.All">Ana Səhifə</NavLink>
                        <NavLink class="nav-link px-3" href="/products">Oyuncaqlar</NavLink>
                        
                        <!-- ✅ BRENDLƏR LİNKİ DÜZƏLDİLDİ (/brands) -->
                        <NavLink class="nav-link px-3" href="/brands">Brendlər</NavLink>

                        <!-- ❤️ Sevdiklərim (Wishlist) -->
                        <div class="nav-item">
                            <NavLink class="nav-link px-3 position-relative d-flex align-items-center" href="/wishlist">
                                <i class="bi bi-heart-fill text-danger fs-4"></i>
                                @if (WishlistService.GetWishlistCount() > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info border border-dark shadow-sm" style="font-size: 0.7rem; margin-top: 5px;">
                                        @WishlistService.GetWishlistCount()
                                    </span>
                                }
                            </NavLink>
                        </div>

                        <!-- 🌙 Gecə/Gündüz Düyməsi -->
                        <div class="nav-item mx-2">
                            <button class="btn btn-outline-light border-0 rounded-circle p-2 shadow-none" @onclick="ToggleTheme">
                                @if (ThemeService.IsDarkMode)
                                {
                                    <i class="bi bi-sun-fill text-warning fs-4 animate-fade"></i>
                                }
                                else
                                {
                                    <i class="bi bi-moon-stars-fill text-info fs-4 animate-fade"></i>
                                }
                            </button>
                        </div>

                        <!-- 🛒 Səbət Düyməsi -->
                        <div class="nav-item ms-lg-2">
                            <NavLink class="btn btn-primary rounded-pill px-4 d-flex align-items-center gap-2 shadow-sm" href="/cart">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="fw-bold">Səbətim</span>
                                @if (CartService.GetTotalCount() > 0)
                                {
                                    <span class="badge rounded-pill bg-danger border border-light">
                                        @CartService.GetTotalCount()
                                    </span>
                                }
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- 🖼️ SƏHİFƏNİN DAXİLİ KONTENTİ -->
        <div class="container-fluid py-2">
            @Body
        </div>

        <ChatBot />

        <!-- 🏢 FOOTER -->
        <footer class="footer mt-auto py-5 border-top bg-light">
            <div class="container text-center">
                <div class="mb-3">
                    <span class="fs-4 fw-bold">ToyStore</span>
                </div>
                <p class="text-muted mb-0">&copy; 2024 ToyStore - Bütün hüquqlar qorunur.</p>
            </div>
        </footer>
    </main>
</div>

<style>
    /* Axtarış Pəncərəsi Dizaynı */
    .global-search-dropdown {
        position: absolute;
        top: 45px;
        left: 0;
        right: 0;
        background: white;
        z-index: 2000; /* Məhsul kartlarının üstündə görünsün */
        max-height: 350px;
        overflow-y: auto;
        border-radius: 12px;
    }

    .search-item-row {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
        transition: 0.2s;
        text-decoration: none;
    }

    .search-item-row:hover { background: #f8f9fa; }

    .search-item-row img {
        width: 40px;
        height: 40px;
        object-fit: contain;
        margin-right: 12px;
        background: white;
        border-radius: 6px;
    }

    .nav-link { font-weight: 500; transition: color 0.3s ease; }
    .nav-link:hover { color: #0d6efd !important; }
    .animate-fade { animation: fadeIn 0.5s ease; }
    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    private string searchText = "";
    private List<ProductDto> allProducts = new();
    private List<ProductDto> searchResults = new();

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartChanged += RefreshUI;
        ThemeService.OnThemeChanged += RefreshUI;
        WishlistService.OnWishlistChanged += RefreshUI;

        // API-dan məlumatları çəkirik
        try {
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("products") ?? new();
        } catch { }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 2)
        {
            searchResults = new();
            return;
        }

        searchResults = allProducts
            .Where(p => p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Take(6)
            .ToList();
    }

    private void SelectProduct(int id)
    {
        searchResults = new();
        searchText = "";
        NavManager.NavigateTo($"/product/{id}");
    }

    private void RefreshUI() => InvokeAsync(StateHasChanged);

    private async Task ToggleTheme() => await ThemeService.ToggleTheme();

    void IDisposable.Dispose()
    {
        CartService.OnCartChanged -= RefreshUI;
        ThemeService.OnThemeChanged -= RefreshUI;
        WishlistService.OnWishlistChanged -= RefreshUI;
    }
}