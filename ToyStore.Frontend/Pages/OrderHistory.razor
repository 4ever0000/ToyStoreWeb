@page "/order-history"
@using ToyStore.Frontend.Services
@using ToyStore.Frontend.Models
@inject HttpClient Http
@inject CartService CartService
@inject NavigationManager NavManager

<div class="container mt-5 mb-5">
    <div class="row mb-5">
        <div class="col-md-12">
            <h1 class="display-5 fw-bold mb-2">📋 Sifariş Tarixçəsi</h1>
            <p class="text-muted lead">Əvvəlki sifarişlərinizə göz atın</p>
        </div>
    </div>

    @if (orders == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="mt-2 text-muted">Sifarişlər yüklənir...</p>
        </div>
    }
    else if (orders.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <h4>📦 Hələlik heç bir sifarişiniz yoxdur</h4>
            <p>Məhsulları görmək üçün kataloğa keçin</p>
            <button class="btn btn-primary mt-3" @onclick='() => NavManager.NavigateTo("/products")'>
                🛍️ Kataloğa Get
            </button>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in orders)
            {
                <div class="col-md-12 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-light p-3">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h5 class="mb-0"><strong>Sifariş #@order.OrderId</strong></h5>
                                    <small class="text-muted">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span class="badge @GetStatusBadge(order.Status)">@order.Status</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h6 class="fw-bold mb-3">Məhsullar:</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <tbody>
                                                @foreach (var item in order.Items)
                                                {
                                                    <tr>
                                                        <td>@item.ProductName</td>
                                                        <td class="text-center">x@item.Quantity</td>
                                                        <td class="text-end">@item.Price.ToString("0.00") AZN</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-4 border-start">
                                    <h6 class="fw-bold mb-3">Xülasə:</h6>
                                    <p class="mb-2 d-flex justify-content-between">
                                        <span>Məhsullar:</span>
                                        <strong>@order.Subtotal.ToString("0.00") AZN</strong>
                                    </p>
                                    <p class="mb-2 d-flex justify-content-between">
                                        <span>Çatdırılma:</span>
                                        <strong>@order.ShippingCost.ToString("0.00") AZN</strong>
                                    </p>
                                    <p class="mb-0 d-flex justify-content-between border-top pt-2">
                                        <span class="fw-bold">Toplam:</span>
                                        <strong class="text-success">@order.TotalAmount.ToString("0.00") AZN</strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white p-3">
                            <button class="btn btn-sm btn-outline-primary" @onclick='() => ViewOrderDetails(order.OrderId)'>
                                📖 Detallı Görüntülə
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrderDto> orders;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // DÜZƏLİŞ: Real API-dan datanı çəkirik (api/v1/orders)
            // Qeyd: Əgər login sistemi varsa, user ID-ni dinamik göndərməlisən
            orders = await Http.GetFromJsonAsync<List<OrderDto>>("orders/user/1") ?? new List<OrderDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Xəta: {ex.Message}");
            orders = new List<OrderDto>();
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Tamamlandı" => "bg-success",
        "Gözləmədə" => "bg-warning",
        "Ləğv edildi" => "bg-danger",
        _ => "bg-info"
    };

    private void ViewOrderDetails(int orderId) => NavManager.NavigateTo($"/order-success/{orderId}");

    public class OrderDto
    {
        public int OrderId { get; set; }
        public DateTime OrderDate { get; set; }
        public string Status { get; set; }
        public decimal Subtotal { get; set; }
        public decimal ShippingCost { get; set; }
        public decimal TotalAmount { get; set; }
        public List<OrderItemDto> Items { get; set; }
    }

    public class OrderItemDto
    {
        public string ProductName { get; set; }
        public int Quantity { get; set; }
        public decimal Price { get; set; }
    }
}