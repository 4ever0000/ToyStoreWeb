@page "/product/{Id:int}"
@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CartService CartService

<div class="container mt-4 mb-5">
    
    <!-- 1. BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded shadow-sm border-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">Ana Səhifə</a></li>
            <li class="breadcrumb-item"><a href="/products" class="text-decoration-none text-primary">Oyuncaqlar</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(product?.Name ?? "Yüklənir...")</li>
        </ol>
    </nav>

    @if (product == null && !isError)
    {
        <!-- 2. SKELETON SCREEN (Yüklənmə effekti) -->
        <div class="row bg-white p-4 shadow-sm rounded border">
            <div class="col-md-6 text-center border-end">
                <div class="skeleton" style="height: 450px; width: 100%;"></div>
            </div>
            <div class="col-md-6 ps-md-5">
                <div class="skeleton mb-3" style="height: 40px; width: 80%;"></div>
                <div class="skeleton mb-4" style="height: 20px; width: 40%;"></div>
                <div class="skeleton mb-4" style="height: 50px; width: 30%;"></div>
                <div class="mb-4">
                    <div class="skeleton mb-2" style="height: 25px; width: 20%;"></div>
                    <div class="skeleton mb-1" style="height: 60px; width: 100%;"></div>
                </div>
                <div class="skeleton rounded-pill" style="height: 60px; width: 100%;"></div>
            </div>
        </div>
    }
    else if (isError)
    {
        <!-- 3. ERROR STATE -->
        <div class="text-center py-5 shadow-sm rounded bg-white mt-5 border">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem; opacity: 0.5;"></i>
            </div>
            <h2 class="fw-bold text-dark">Məhsul tapılmadı! ❌</h2>
            <p class="text-muted">Axtardığınız məhsul sistemdə mövcud deyil.</p>
            <button class="btn btn-primary btn-lg mt-3 px-5 rounded-pill shadow" @onclick='() => NavManager.NavigateTo("/products")'>
                Kataloqa qayıt
            </button>
        </div>
    }
    else
    {
        <!-- REAL MƏHSUL GÖRÜNÜŞÜ -->
        <div class="row bg-white p-4 shadow-sm rounded border">
            <div class="col-md-6 text-center border-end d-flex align-items-center justify-content-center rounded">
                <img src="@product.ImageUrl" class="img-fluid rounded shadow-sm p-3" style="max-height: 450px; object-fit: contain;" alt="@product.Name" />
            </div>
            <div class="col-md-6 ps-md-5 mt-4 mt-md-0">
                <h1 class="display-6 fw-bold text-dark">@product.Name</h1>
                <p class="text-muted small">Brend ID: #@product.BrandId | Kateqoriya ID: #@product.CategoryId</p>
                
                <h2 class="text-success fw-bold my-4">@product.Price.ToString("0.00") AZN</h2>
                
                <div class="mb-4">
                    <h5 class="border-bottom pb-2 fw-bold text-dark">Haqqında</h5>
                    <p class="text-secondary" style="line-height: 1.6;">@product.Description</p>
                </div>

                <div class="card bg-light border-0 p-3 shadow-sm rounded-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="small text-muted">Stok vəziyyəti:</span>
                            <p class="mb-0 fw-bold @(product.StockQuantity < 5 ? "text-danger" : "text-success")">
                                <i class="bi bi-box-seam me-1"></i> @product.StockQuantity ədəd mövcuddur
                            </p>
                        </div>
                        <button class="btn btn-primary btn-lg px-4 shadow rounded-pill" @onclick="HandleAddToCart" disabled="@isAdding">
                            @if (isAdding)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {

                                <i class="bi bi-cart-plus me-1"></i>
                            }
                            @buttonText
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ⭐ YORUM & RATING BÖLÜMÜ ⭐ -->
        <div class="container mt-5 px-0">
            <div class="row g-4">
                <!-- Yorum Özeti -->
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 p-4 text-center h-100 bg-white">
                        <h3 class="fw-bold mb-3">Müştəri Rəyləri</h3>
                        <h1 class="text-warning display-4 fw-bold">@GetAverageRating().ToString("0.0")</h1>
                        <div class="mb-2 fs-4 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= (int)GetAverageRating() ? "★" : "☆")</span>
                            }
                        </div>
                        <p class="text-muted small">@reviews.Count rəy əsasında</p>
                        <hr />
                        @for (int star = 5; star >= 1; star--)
                        {
                            var count = reviews.Count(r => r.Rating == star);
                            var percentage = reviews.Count > 0 ? (count * 100) / reviews.Count : 0;
                            <div class="d-flex align-items-center mb-1">
                                <span class="small me-2" style="min-width: 30px;">@star ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                </div>
                                <span class="small ms-2 text-muted">@count</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Yorum Yazma Formu -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0 p-4 bg-white h-100">
                        <h4 class="fw-bold mb-3">📝 Şərhini Yaz</h4>
                        @if (showReviewSuccess)
                        {
                            <div class="alert alert-success py-2 small text-center">✅ Şərhiniz uğurla əlavə edildi!</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input type="text" class="form-control" placeholder="Adınız" @bind="newReview.UserName" />
                            </div>
                            <div class="col-md-6 d-flex align-items-center">
                                <span class="me-2 fw-bold small">Rating:</span>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var star = i;
                                    <i class="bi @(newReview.Rating >= star ? "bi-star-fill text-warning" : "bi-star text-muted") fs-4 me-1"
                                       style="cursor:pointer" @onclick='() => newReview.Rating = star'></i>
                                }
                            </div>
                            <div class="col-12">
                                <textarea class="form-control" rows="3" placeholder="Məhsul haqqında fikirləriniz..." @bind="newReview.Comment"></textarea>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-dark rounded-pill px-4" @onclick="SubmitReview" disabled="@isSubmittingReview">
                                    @(isSubmittingReview ? "Göndərilir..." : "📤 Şərh Göndər")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Şərhlər Listesi -->
            <div class="mt-5">
                <h4 class="fw-bold mb-4">Bütün Şərhlər (@reviews.Count)</h4>
                @if (!reviews.Any())
                {
                    <p class="text-muted">Hələ ki, rəy yoxdur. İlk rəyi sən yaz!</p>
                }
                else
                {
                    @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="card shadow-sm border-0 mb-3 p-3 bg-white">
                            @if (editingReviewId == review.Id)
                            {
                                <textarea class="form-control mb-2" @bind="editingComment"></textarea>
                                <div class="mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var star = i;
                                        <i class="bi @(editingRating >= star ? "bi-star-fill text-warning" : "bi-star text-muted") fs-5 me-1"
                                           style="cursor:pointer" @onclick='() => editingRating = star'></i>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success px-3" @onclick="() => SaveEditReview(review.Id)">Saxla</button>
                                    <button class="btn btn-sm btn-secondary px-3" @onclick="CancelEdit">Ləğv et</button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">
                                            @review.UserName
                                            @if (review.IsVerifiedPurchase)
                                            {
                                                <span class="badge bg-success-subtle text-success ms-2 small">✓ Alıcı</span>
                                            }
                                        </h6>
                                        <div class="text-warning small mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span>@(i <= review.Rating ? "★" : "☆")</span>
                                            }
                                        </div>
                                        <p class="text-secondary mb-0">@review.Comment</p>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block mb-2">@review.CreatedAt.ToString("dd.MM.yyyy")</small>
                                        <button class="btn btn-sm btn-outline-primary border-0 me-1" @onclick="() => StartEditReview(review)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeleteReview(review.Id)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private ProductDto product;
    private List<ReviewDto> reviews = new();
    private bool isError = false;
    private bool isAdding = false;
    private bool isSubmittingReview = false;
    private bool showReviewSuccess = false;
    private string buttonText = "Səbətə at";
    private CreateReviewDto newReview = new() { Rating = 5 };

    private int editingReviewId = -1;
    private string editingComment = "";
    private int editingRating = 0;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            product = await Http.GetFromJsonAsync<ProductDto>($"products/{Id}");
            if (product == null) isError = true;
            else reviews = await Http.GetFromJsonAsync<List<ReviewDto>>($"reviews/product/{Id}") ?? new();
        }
        catch { isError = true; }
    }

    private decimal GetAverageRating() => reviews.Any() ? (decimal)reviews.Average(r => r.Rating) : 0;

    private async Task SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(newReview.UserName) || string.IsNullOrWhiteSpace(newReview.Comment)) return;
        isSubmittingReview = true;
        try
        {
            newReview.ProductId = Id;
            var response = await Http.PostAsJsonAsync("reviews", newReview);
            if (response.IsSuccessStatusCode)
            {
                var addedReview = await response.Content.ReadFromJsonAsync<ReviewDto>();
                if (addedReview != null) reviews.Add(addedReview);
                newReview = new() { Rating = 5 };
                showReviewSuccess = true;
                await Task.Delay(3000);
                showReviewSuccess = false;
            }
        }
        finally { isSubmittingReview = false; }
    }

    private async Task DeleteReview(int reviewId)
    {
        var response = await Http.DeleteAsync($"reviews/{reviewId}");
        if (response.IsSuccessStatusCode)
        {
            reviews.RemoveAll(r => r.Id == reviewId);
        }
    }

    private void StartEditReview(ReviewDto review)
    {
        editingReviewId = review.Id;
        editingComment = review.Comment;
        editingRating = review.Rating;
    }

    private void CancelEdit() => editingReviewId = -1;

    private async Task SaveEditReview(int reviewId)
    {
        var response = await Http.PutAsJsonAsync($"reviews/{reviewId}", new { comment = editingComment, rating = editingRating });
        if (response.IsSuccessStatusCode)
        {
            var r = reviews.FirstOrDefault(x => x.Id == reviewId);
            if (r != null)
            {
                r.Comment = editingComment;
                r.Rating = editingRating;
            }
            CancelEdit();
        }
    }

    private async Task HandleAddToCart()
    {
        if (product == null || isAdding) return;
        isAdding = true;
        try
        {
            var response = await Http.PostAsJsonAsync("cart", new { UserId = 1, ProductId = product.Id, Quantity = 1 });
            if (response.IsSuccessStatusCode)
            {
                buttonText = "Əlavə edildi! ✅";
                CartService.AddToCart(product);
                await Task.Delay(2000);
                buttonText = "Səbətə at";
            }
        }
        finally { isAdding = false; }
    }
}