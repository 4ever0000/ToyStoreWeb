@page "/"
@page "/index"
@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CartService CartService
@inject WishlistService WishlistService
@inject ThemeService ThemeService
@implements IDisposable

<!-- ✨ HERO BANNER (LEGO Temalı və Animasiyalı) ✨ -->
<section class="hero-section text-white shadow-lg overflow-hidden">
    <div class="container py-5 pos-relative">
        <div class="row align-items-center py-5">
            <div class="col-lg-6 animate-fade-in">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">YENİ KOLLEKSİYA</span>
                <h1 class="display-3 fw-bold mb-3">Yeni LEGO Dünyasını Kəşf Et! 🧱</h1>
                <p class="lead mb-4 opacity-90">Ən son gələn konstruktorlar və sevimli personajlar artıq satışda. Hər yaşa uyğun əyləncə burada!</p>
                <div class="d-flex gap-3">
                    <button class="btn btn-light btn-lg px-5 shadow-sm fw-bold rounded-pill text-primary" @onclick='() => NavManager.NavigateTo("/products")'>
                        🛍️ İndi Al
                    </button>
                    <button class="btn btn-outline-light btn-lg px-4 rounded-pill" @onclick='() => NavManager.NavigateTo("/products")'>
                        Kataloq
                    </button>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block text-center animate-bounce">
                <!-- Bura bir LEGO oyuncaq şəkli və ya ikon qoya bilərsən -->
                <i class="bi bi-bricks text-white" style="font-size: 10rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>
    <!-- Bannerin altındakı dalğa effekti -->
    <div class="hero-wave">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C56.1,43.27,173.24,75.66,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</section>

<!-- ⭐ POPULYAR MƏHSULLAR (SKELETON İLƏ) ⭐ -->
<section class="products-section py-5 bg-dynamic">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold mb-0">⭐ Populyar Məhsullar</h2>
                <p class="text-muted mb-0">Müştərilərimizin ən çox bəyəndiyi seçimlər</p>
            </div>
            <button class="btn btn-outline-primary rounded-pill px-4" @onclick='() => NavManager.NavigateTo("/products")'>
                Hamısını gör <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>

        @if (popularProducts == null)
        {
            <!-- SKELETON SCREEN (Yükləmə zamanı görünən boz bloklar) -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm p-3">
                            <div class="skeleton mb-3" style="height: 200px; width: 100%;"></div>
                            <div class="skeleton mb-2" style="height: 20px; width: 80%;"></div>
                            <div class="skeleton" style="height: 25px; width: 40%;"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                @foreach (var product in popularProducts)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 product-card overflow-hidden" 
                             @onclick='() => NavManager.NavigateTo($"/product/{product.Id}")'>

                            <div class="card-badge">Top</div>

                            <!-- Wishlist (Ürək) -->
                            <button class="wishlist-btn" @onclick:stopPropagation="true" @onclick="() => ToggleWishlist(product)">
                                <i class="bi @(WishlistService.IsInWishlist(product.Id) ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                            </button>

                            <div class="card-img-container p-4 d-flex align-items-center justify-content-center bg-light-gray" style="height: 200px;">
                                <img src="@product.ImageUrl" class="card-img-top img-fluid h-100" alt="@product.Name" style="object-fit: contain;">
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h6 class="card-title fw-bold text-dark">@product.Name</h6>
                                
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                    <h5 class="text-primary fw-bold mb-0">@product.Price.ToString("0.00") AZN</h5>
                                    <button class="btn btn-primary rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center" 
                                            style="width:40px; height:40px;" 
                                            @onclick:stopPropagation="true" @onclick="() => CartService.AddToCart(product)">
                                        <i class="bi bi-cart-plus fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- 📢 İNFO BÖLÜMÜ 📢 -->
<section class="info-section py-5 bg-dynamic-alt border-top">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-glass shadow-sm h-100 d-flex align-items-center">
                    <i class="bi bi-truck text-primary display-6 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Sürətli Çatdırılma</h6>
                        <p class="text-muted small mb-0">Bütün ölkəyə çatdırılma mövcuddur</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-glass shadow-sm h-100 d-flex align-items-center">
                    <i class="bi bi-shield-check text-success display-6 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Orijinal Məhsul</h6>
                        <p class="text-muted small mb-0">100% keyfiyyət və zəmanət</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-glass shadow-sm h-100 d-flex align-items-center">
                    <i class="bi bi-arrow-repeat text-danger display-6 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Asan Qaytarılma</h6>
                        <p class="text-muted small mb-0">14 gün ərzində geri qaytarma</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private List<ProductDto> popularProducts;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += RefreshUI;
        WishlistService.OnWishlistChanged += RefreshUI;
        try {
            // Bir az gecikmə (yüklənmə effektini görmək üçün)
            // await Task.Delay(1000); 
            var all = await Http.GetFromJsonAsync<List<ProductDto>>("products");
            // Ana səhifədə 4 məhsul göstərmək daha simmetrikdir (row-cols-lg-4 üçün)
            popularProducts = all?.Take(4).ToList();
        } catch { 
            popularProducts = new(); 
        }
    }

    private void RefreshUI() => InvokeAsync(StateHasChanged);
    private void ToggleWishlist(ProductDto p) => WishlistService.ToggleWishlist(p);

    public void Dispose() {
        ThemeService.OnThemeChanged -= RefreshUI;
        WishlistService.OnWishlistChanged -= RefreshUI;
    }
}

<style>
    /* 🎨 CSS Təkmilləşdirmələri */
    .hero-section {
        background: linear-gradient(135deg, #FF4B2B 0%, #FF416C 100%);
        border-radius: 0 0 50px 50px;
        position: relative;
        min-height: 500px;
        display: flex;
        align-items: center;
    }

    /* Hero Wave Effect */
    .hero-wave {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }
    .hero-wave svg {
        position: relative;
        display: block;
        width: calc(100% + 1.3px);
        height: 70px;
    }
    .hero-wave .shape-fill { fill: var(--bs-body-bg); }

    /* Card Badge */
    .card-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #FFD700;
        color: #000;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: bold;
        z-index: 2;
        text-transform: uppercase;
    }

    .bg-dynamic { background-color: var(--bs-body-bg); }
    .bg-dynamic-alt { background-color: var(--bs-tertiary-bg); }
    .bg-light-gray { background-color: rgba(0,0,0,0.02); }
    [data-bs-theme="dark"] .bg-light-gray { background-color: rgba(255,255,255,0.05); }

    .bg-glass { background: rgba(var(--bs-emphasis-color-rgb), 0.02); transition: 0.3s; border: 1px solid rgba(var(--bs-emphasis-color-rgb), 0.05); }
    .bg-glass:hover { transform: translateY(-5px); background: rgba(var(--bs-emphasis-color-rgb), 0.05); }

    .animate-bounce {
        animation: bounce 3s infinite;
    }
    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }
</style>