@page "/profile"
@using ToyStore.Frontend.Services
@inject CartService CartService
@inject NavigationManager NavManager

<div class="container mt-5 mb-5">
    <!-- Səhifə Başlığı -->
    <div class="row mb-5">
        <div class="col-md-12">
            <h1 class="display-5 fw-bold mb-2">👤 Profil</h1>
            <p class="text-muted lead">Şəxsi məlumatlarınızı yəniləyin</p>
        </div>
    </div>

    <div class="row">
        <!-- Sol Taraf - Menu -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="list-group list-group-flush">
                    <button class="list-group-item list-group-item-action @(activeTab == "profile" ? "active" : "")" 
                            @onclick='() => activeTab = "profile"'>
                        👤 Profil Məlumatları
                    </button>
                    <button class="list-group-item list-group-item-action @(activeTab == "address" ? "active" : "")" 
                            @onclick='() => activeTab = "address"'>
                        📍 Ünvanlar
                    </button>
                    <button class="list-group-item list-group-item-action @(activeTab == "password" ? "active" : "")" 
                            @onclick='() => activeTab = "password"'>
                        🔐 Şifrə Dəyişdir
                    </button>
                    <button class="list-group-item list-group-item-action @(activeTab == "notifications" ? "active" : "")" 
                            @onclick='() => activeTab = "notifications"'>
                        🔔 Bildirimlər
                    </button>
                    <button class="list-group-item list-group-item-action @(activeTab == "security" ? "active" : "")" 
                            @onclick='() => activeTab = "security"'>
                        🛡️ Səlahiyyət
                    </button>
                </div>
            </div>
        </div>

        <!-- Sağ Taraf - İçerik -->
        <div class="col-md-9 mb-4">
            <!-- Profil Məlumatları -->
            @if (activeTab == "profile")
            {
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="fw-bold mb-4">👤 Profil Məlumatları</h4>

                    <div class="text-center mb-4">
                        <img src="https://via.placeholder.com/120x120?text=Avatar" class="rounded-circle shadow" alt="Avatar" />
                        <p class="mt-3">
                            <a href="#" class="btn btn-sm btn-outline-primary">Avatarı Dəyişdir</a>
                        </p>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ad</label>
                            <input type="text" class="form-control" @bind="profile.FirstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Soyad</label>
                            <input type="text" class="form-control" @bind="profile.LastName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" @bind="profile.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Telefon</label>
                        <input type="tel" class="form-control" @bind="profile.Phone" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Doğum Tarixi</label>
                        <input type="date" class="form-control" @bind="profile.DateOfBirth" />
                    </div>

                    <button class="btn btn-primary btn-lg w-100">💾 Dəyişlikləri Saxla</button>
                </div>
            }

            <!-- Ünvanlar -->
            @if (activeTab == "address")
            {
                <div class="card shadow-sm border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0">📍 Ünvanlar</h4>
                        <button class="btn btn-sm btn-success">+ Yeni Ünvan</button>
                    </div>

                    @foreach (var addr in addresses)
                    {
                        <div class="card mb-3 bg-light">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="fw-bold">@addr.Title</h6>
                                        <p class="text-secondary mb-0">
                                            @addr.Address<br/>
                                            @addr.City, @addr.PostalCode
                                        </p>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-primary">Düzəlt</button>
                                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                                    </div>
                                </div>
                                @if (addr.IsDefault)
                                {
                                    <small class="badge bg-primary mt-2">Varsayılan</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Şifrə Dəyişdir -->
            @if (activeTab == "password")
            {
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="fw-bold mb-4">🔐 Şifrə Dəyişdir</h4>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Cari Şifrə</label>
                        <input type="password" class="form-control" placeholder="Cari şifrənizi girin" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Yeni Şifrə</label>
                        <input type="password" class="form-control" placeholder="Yeni şifrə girin" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Yeni Şifrəni Doğrula</label>
                        <input type="password" class="form-control" placeholder="Yeni şifrəyi yenidən girin" />
                    </div>

                    <small class="text-muted d-block mb-3">
                        Şifrə en az 8 simvol olmalı və harfleri, rəqəmləri içermelidir.
                    </small>

                    <button class="btn btn-primary btn-lg w-100">🔄 Şifrəni Dəyişdir</button>
                </div>
            }

            <!-- Bildirimlər -->
            @if (activeTab == "notifications")
            {
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="fw-bold mb-4">🔔 Bildirimlər</h4>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emailNotif" checked />
                            <label class="form-check-label" for="emailNotif">
                                <strong>Email Bildirimleri</strong>
                                <p class="text-muted small">Yeni məhsullar, promosyonlar və xəbərlər hakkında email alın</p>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="smsNotif" checked />
                            <label class="form-check-label" for="smsNotif">
                                <strong>SMS Bildirimleri</strong>
                                <p class="text-muted small">Sifariş güncellemeleri ve önemli uyarılar hakkında SMS alın</p>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="pushNotif" />
                            <label class="form-check-label" for="pushNotif">
                                <strong>Push Bildirimleri</strong>
                                <p class="text-muted small">Tarayıcı bildirimleri alın</p>
                            </label>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-lg w-100">💾 Bildirimleri Saxla</button>
                </div>
            }

            <!-- Səlahiyyət -->
            @if (activeTab == "security")
            {
                <div class="card shadow-sm border-0 p-4">
                    <h4 class="fw-bold mb-4">🛡️ Səlahiyyət</h4>

                    <h6 class="fw-bold mb-3">Aktif Oturumlar</h6>
                    <div class="card mb-3 bg-light">
                        <div class="card-body">
                            <p class="mb-2">
                                <strong>💻 Windows</strong><br/>
                                <small class="text-muted">Chrome Browser - Bakı, Azərbaycam</small>
                            </p>
                            <small class="text-muted">Son 1 saat əvvəl aktiv</small>
                            <button class="btn btn-sm btn-outline-danger float-end">Çıx</button>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3 mt-4">İki Faktor Doğrulama</h6>
                    <div class="alert alert-info">
                        <p class="mb-2">
                            <strong>İki Faktor Doğrulaması Hazırlanmadı</strong>
                        </p>
                        <p class="text-secondary small">
                            Əlavə təhlükəsiz olmaq üçün iki faktor doğrulama aktivləşdirin.
                        </p>
                        <button class="btn btn-sm btn-success">Aktivləştir</button>
                    </div>

                    <h6 class="fw-bold mb-3 mt-4">Cihaz Yönetimi</h6>
                    <button class="btn btn-outline-danger w-100">Bütün Cihazlardan Çıx</button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .list-group-item {
        border-radius: 0;
    }

    .list-group-item.active {
        background-color: #667eea;
        border-color: #667eea;
    }

    .card {
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .card:hover {
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }

    .form-control, .form-select {
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
</style>

@code {
    private string activeTab = "profile";

    private ProfileModel profile = new()
    {
        FirstName = "Aylin",
        LastName = "Əlizadə",
        Email = "aylin@example.com",
        Phone = "+994 50 123 4567",
        DateOfBirth = new DateTime(1995, 5, 15)
    };

    private List<AddressModel> addresses = new()
    {
        new AddressModel
        {
            Title = "Ev",
            Address = "28 May küçəsi, Apartman 45",
            City = "Bakı",
            PostalCode = "AZ1000",
            IsDefault = true
        },
        new AddressModel
        {
            Title = "İş",
            Address = "Azadlıq prospekti, Bina 10",
            City = "Bakı",
            PostalCode = "AZ1001",
            IsDefault = false
        }
    };

    public class ProfileModel
    {
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string Email { get; set; }
        public string Phone { get; set; }
        public DateTime DateOfBirth { get; set; }
    }

    public class AddressModel
    {
        public string Title { get; set; }
        public string Address { get; set; }
        public string City { get; set; }
        public string PostalCode { get; set; }
        public bool IsDefault { get; set; }
    }
}
