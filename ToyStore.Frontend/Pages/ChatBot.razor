@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject CartService CartService
@inject NavigationManager NavManager

<div class="chatbot-container @(isOpen ? "open" : "") shadow-lg">
    <!-- 🟢 Chat Düyməsi -->
    @if (!isOpen)
    {
        <div class="chat-toggle-btn" @onclick="ToggleChat">
            <i class="bi bi-stars"></i>
        </div>
    }
    else
    {
        <!-- ⚪ Chat Başlığı -->
        <div class="chat-header shadow-sm" @onclick="ToggleChat">
            <span class="fw-bold"><i class="bi bi-stars me-2"></i> The Shining AI</span>
            <i class="bi bi-chevron-down float-end"></i>
        </div>

        <!-- ⚪ Mesajlar Hissəsi -->
        <div class="chat-body" id="chatBody">
            <div class="message ai shadow-sm">
                Salam! Mən **The Shining** ✨ Sizin ağıllı oyuncaq köməkçinizəm.
                Sualınızı yaza bilərsiniz (məs: **Lego**, **Cap** və ya bir qiymət: **15**)
            </div>

            @foreach (var msg in messages)
            {
                <div class="message @(msg.IsUser ? "user shadow-sm" : "ai shadow-sm")">
                    @msg.Text

                    @if (msg.Products != null && msg.Products.Any())
                    {
                        <div class="bot-product-list mt-3">
                            @foreach (var prod in msg.Products)
                            {
                                <!-- 🔴 MƏHSUL KARTINA KLİKLƏYƏNDƏ DETALLARA GEDİR -->
                                <div class="bot-product-card shadow-sm border rounded-3 bg-white p-2 mb-2 cursor-pointer"
                                     @onclick="() => NavigateToDetails(prod.Id)">
                                    <div class="d-flex align-items-center">
                                        <img src="@prod.ImageUrl" class="rounded me-2" style="width: 50px; height: 50px; object-fit: contain;" />
                                        <div class="flex-grow-1 overflow-hidden text-start">
                                            <div class="fw-bold small text-truncate text-dark">@prod.Name</div>
                                            <div class="text-success fw-bold small">@prod.Price.ToString("0.00") AZN</div>
                                        </div>
                                        <!-- stopPropagation="true" sayəsində səbətə atanda naviqasiya işə düşmür -->
                                        <button class="btn btn-sm btn-primary rounded-circle ms-2"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => AddToCart(prod)">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (isTyping)
            {
                <div class="message ai typing shadow-sm">
                    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                </div>
            }
        </div>

        <!-- 🟡 Sürətli Düymələr -->
        <div class="quick-buttons px-2 py-1 bg-light border-top d-flex gap-1 overflow-auto">
            <button class="btn btn-xs btn-outline-secondary rounded-pill text-nowrap" @onclick='() => QuickAction("Lego")'>Lego</button>
            <button class="btn btn-xs btn-outline-secondary rounded-pill text-nowrap" @onclick='() => QuickAction("Funko")'>Funko</button>
            <button class="btn btn-xs btn-outline-secondary rounded-pill text-nowrap" @onclick='() => QuickAction("15")'>15 AZN-ə qədər</button>
            <button class="btn btn-xs btn-outline-secondary rounded-pill text-nowrap" @onclick='() => QuickAction("Cap")'>Captain</button>
        </div>

        <!-- 🔵 Yazma Hissəsi -->
        <div class="chat-footer">
            <div class="input-group">
                <input type="text" class="form-control border-0 shadow-none"
                       placeholder="Ad və ya qiymət yazın..."
                       @bind="userMessage" @onkeypress="HandleKeyPress" />
                <button class="btn btn-primary rounded-circle ms-2 shadow-sm" @onclick="SendMessage">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen = false;
    private bool isTyping = false;
    private string userMessage = "";
    private List<ChatMessage> messages = new();
    private List<ProductDto> allProducts = new();

    protected override async Task OnInitializedAsync()
    {
        try { allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("products") ?? new(); }
        catch { }
    }

    private void ToggleChat() => isOpen = !isOpen;

    private void NavigateToDetails(int id)
    {
        NavManager.NavigateTo($"/product/{id}");
        isOpen = false; // Məhsula keçid edəndə çat pəncərəsini bağla (istəyə görə)
    }

    private async Task QuickAction(string action)
    {
        userMessage = action;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userMessage)) return;
        var tempMsg = userMessage;
        messages.Add(new ChatMessage { Text = tempMsg, IsUser = true });
        userMessage = "";
        isTyping = true;
        await Task.Delay(800);
        var response = ProcessAIResponse(tempMsg);
        messages.Add(response);
        isTyping = false;
    }

    private ChatMessage ProcessAIResponse(string input)
    {
        input = input.ToLower().Trim();
        var response = new ChatMessage { IsUser = false };

        if (decimal.TryParse(input, out decimal priceLimit))
        {
            var found = allProducts.Where(p => p.Price <= priceLimit).OrderByDescending(p => p.Price).Take(4).ToList();
            if (found.Any())
            {
                response.Text = $"{priceLimit} AZN büdcəyə qədər seçimlərimiz:";
                response.Products = found;
            }
            else { response.Text = $"Təəssüf ki, {priceLimit} AZN qiymətinə uyğun məhsul tapmadım."; }
        }
        else if (input.Length >= 2)
        {
            var found = allProducts.Where(p => p.Name.ToLower().Contains(input)).Take(4).ToList();
            if (found.Any())
            {
                response.Text = $"'{input}' üçün tapdıqlarım:";
                response.Products = found;
            }
            else { response.Text = $"'{input}' adına uyğun heç nə tapmadım."; }
        }
        else { response.Text = "Salam! Mənə bir oyuncaq adı (məs: Cap) və ya bir rəqəm (məs: 20) yazın."; }

        return response;
    }

    private void AddToCart(ProductDto prod) => CartService.AddToCart(prod);

    private async Task HandleKeyPress(KeyboardEventArgs e) { if (e.Key == "Enter") await SendMessage(); }

    public class ChatMessage
    {
        public string Text { get; set; }
        public bool IsUser { get; set; }
        public List<ProductDto> Products { get; set; }
    }
}