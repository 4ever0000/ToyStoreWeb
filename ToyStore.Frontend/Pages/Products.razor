@page "/products"
@page "/products/{BrandId:int}"
@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CartService CartService

<div class="container-fluid mt-4 mb-5">
    <!-- Başlıq Hissəsi -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">
                @(BrandId.HasValue ? "Seçilmiş Brend Məhsulları" : "Bütün Oyuncaqlar") 🧸
            </h2>
            @if (BrandId.HasValue)
            {
                <button class="btn btn-link p-0 text-decoration-none text-muted" @onclick='() => NavManager.NavigateTo("/products")'>
                    ⬅ Bütün məhsullara qayıt
                </button>
            }
        </div>
        <span class="badge bg-primary fs-5 rounded-pill px-3">
            Cəmi: @(filteredProducts?.Count ?? 0) məhsul
        </span>
    </div>

    <!-- 🔍 AXTARIŞ & FİLTRLƏR BÖLÜMÜ 🔍 -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm p-4 bg-light">
                <div class="row g-3">
                    <!-- Axtarış Boxu -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">🔍 Axtarış</label>
                        <input type="text" class="form-control" placeholder="Məhsul adını yaz..." 
                               @bind="searchText" @bind:event="oninput" @onchange="ApplyFilters" />
                    </div>

                    <!-- Qiymət Filtri (Min) -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Min Qiymət</label>
                        <input type="number" class="form-control" placeholder="0" 
                               @bind="minPrice" @bind:event="onchange" @onblur="ApplyFilters" />
                    </div>

                    <!-- Qiymət Filtri (Max) -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Max Qiymət</label>
                        <input type="number" class="form-control" placeholder="999" 
                               @bind="maxPrice" @bind:event="onchange" @onblur="ApplyFilters" />
                    </div>

                    <!-- Sıralanma -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">📊 Sıralanma</label>
                        <select class="form-select" @onchange="(ChangeEventArgs e) => { sortBy = e.Value.ToString(); ApplyFilters(); }">
                            <option value="name">📝 Ada Göra (A-Z)</option>
                            <option value="price-asc">💰 Qiymətə Göra (Ucuz → Bahalı)</option>
                            <option value="price-desc">💰 Qiymətə Göra (Bahalı → Ucuz)</option>
                            <option value="stock">📦 Stoka Göra (Ən Çox)</option>
                        </select>
                    </div>

                    <!-- Brendlər Filtri -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">🏷️ Brendlər</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm @(selectedBrands.Count == 0 ? "btn-primary" : "btn-outline-primary")" 
                                    @onclick="() => { selectedBrands.Clear(); ApplyFilters(); }">
                                Hamısı
                            </button>
                            @if (allBrands != null)
                            {
                                @foreach (var brand in allBrands)
                                {
                                    <button class="btn btn-sm @(selectedBrands.Contains(brand.Id) ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => ToggleBrand(brand.Id)">
                                        @brand.Name
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <!-- Kateqoriyalar Filtri -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">🏪 Kateqoriyalar</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm @(selectedCategories.Count == 0 ? "btn-success" : "btn-outline-success")" 
                                    @onclick="() => { selectedCategories.Clear(); ApplyFilters(); }">
                                Hamısı
                            </button>
                            @if (allCategories != null)
                            {
                                @foreach (var category in allCategories)
                                {
                                    <button class="btn btn-sm @(selectedCategories.Contains(category.Id) ? "btn-success" : "btn-outline-success")" 
                                            @onclick="() => ToggleCategory(category.Id)">
                                        @category.Name
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <!-- Filtri Sıfırla Düyməsi -->
                    <div class="col-md-12">
                        <button class="btn btn-warning w-100" @onclick="ResetFilters">
                            🔄 Filtirləri Sıfırla
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (allProducts == null)
    {
        <!-- Yüklənmə anı -->
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="mt-2 text-muted">Oyuncaqlar kataloqu hazırlanır...</p>
        </div>
    }
    else if (filteredProducts.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <h4>😢 Məhsul tapılmadı</h4>
            <p>Filterlərinizi dəyişib yenidən cəhd edin</p>
            <button class="btn btn-primary mt-3" @onclick="ResetFilters">
                Filtirləri Sıfırla
            </button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in filteredProducts)
            {
                @if (item.IsActive)
                {
                    <div class="col">
                        <!-- ✅ KARTIN ÜZƏRİNƏ BASANDA DETAY SƏHİFƏSİNƏ KEÇİD -->
                        <div class="card h-100 shadow-sm border-0 position-relative product-card"
                             style="cursor: pointer; transition: transform 0.2s;"
                             @onclick='() => NavManager.NavigateTo($"/product/{item.Id}")'>

                            <!-- Stok miqdarı az qalıbsa -->
                            @if (item.StockQuantity < 10 && item.StockQuantity > 0)
                            {
                                <span class="position-absolute top-0 start-0 badge bg-danger m-2 shadow">
                                    Son @item.StockQuantity ədəd!
                                </span>
                            }
                            @if (item.StockQuantity == 0)
                            {
                                <span class="position-absolute top-0 start-0 badge bg-secondary m-2 shadow">
                                    Stokda Yoxdur
                                </span>
                            }

                            <!-- Məhsul Şəkli -->
                            <div class="text-center p-3" style="background-color: #fbfbfb;">
                                <img src="@item.ImageUrl" class="card-img-top rounded"
                                     alt="@item.Name" style="height: 250px; object-fit: contain;">
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold text-dark">@item.Name</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(item.Description?.Length > 80 ? item.Description.Substring(0, 77) + "..." : item.Description ?? "Məlumat yoxdur")
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="h4 mb-0 text-primary fw-bold">@item.Price.ToString("0.00") AZN</span>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-top-0 pb-3">
                                <button class="btn btn-primary w-100" 
                                        @onclick:stopPropagation="true"
                                        @onclick="() => AddToCart(item)"
                                        disabled="@(item.StockQuantity == 0)">
                                    🛒 Səbətə at
                                </button>
                                <div class="d-flex justify-content-between small text-muted mt-2">
                                    <span>Anbarda: <b>@item.StockQuantity</b></span>
                                    <span>ID: #@item.Id</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    /* Kartın üzərinə gələndə bir az böyüməsi üçün kiçik effekt */
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-outline-primary:hover, .btn-outline-success:hover {
        transition: all 0.2s ease;
    }
</style>

@code {
    [Parameter] public int? BrandId { get; set; }

    private List<ProductDto> allProducts;
    private List<ProductDto> filteredProducts;
    private List<BrandDto> allBrands;
    private List<CategoryDto> allCategories;

    // Filtreleme değişkenleri
    private string searchText = "";
    private decimal minPrice = 0;
    private decimal maxPrice = 999999;
    private string sortBy = "name";
    private List<int> selectedBrands = new();
    private List<int> selectedCategories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Bütün məhsulları, brendləri və kateqoriyaları çəkirik
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("products");
            allBrands = await Http.GetFromJsonAsync<List<BrandDto>>("brands") ?? new List<BrandDto>();
            allCategories = await Http.GetFromJsonAsync<List<CategoryDto>>("categories") ?? new List<CategoryDto>();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Xəta baş verdi: {ex.Message}");
            allProducts = new List<ProductDto>();
            allBrands = new List<BrandDto>();
            allCategories = new List<CategoryDto>();
            filteredProducts = new List<ProductDto>();
        }
    }

    // Səhifə daxili keçidlərdə (Məs: Brendlər arası) filtrin yenilənməsi üçün
    protected override void OnParametersSet()
    {
        if (BrandId.HasValue && !selectedBrands.Contains(BrandId.Value))
        {
            selectedBrands.Clear();
            selectedBrands.Add(BrandId.Value);
        }
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allProducts == null) return;

        // Filtirləri tətbiq et
        filteredProducts = allProducts
            .Where(p => p.IsActive)
            .Where(p => string.IsNullOrEmpty(searchText) || p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Where(p => p.Price >= minPrice && p.Price <= maxPrice)
            .Where(p => selectedBrands.Count == 0 || selectedBrands.Contains(p.BrandId))
            .Where(p => selectedCategories.Count == 0 || selectedCategories.Contains(p.CategoryId))
            .ToList();

        // Sıralama tətbiq et
        filteredProducts = sortBy switch
        {
            "price-asc" => filteredProducts.OrderBy(p => p.Price).ToList(),
            "price-desc" => filteredProducts.OrderByDescending(p => p.Price).ToList(),
            "stock" => filteredProducts.OrderByDescending(p => p.StockQuantity).ToList(),
            _ => filteredProducts.OrderBy(p => p.Name).ToList()
        };
    }

    private void ToggleBrand(int brandId)
    {
        if (selectedBrands.Contains(brandId))
            selectedBrands.Remove(brandId);
        else
            selectedBrands.Add(brandId);

        ApplyFilters();
    }

    private void ToggleCategory(int categoryId)
    {
        if (selectedCategories.Contains(categoryId))
            selectedCategories.Remove(categoryId);
        else
            selectedCategories.Add(categoryId);

        ApplyFilters();
    }

    private void ResetFilters()
    {
        searchText = "";
        minPrice = 0;
        maxPrice = 999999;
        sortBy = "name";
        selectedBrands.Clear();
        selectedCategories.Clear();
        ApplyFilters();
    }

    private void AddToCart(ProductDto product)
    {
        var modelProduct = new ProductDto
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            Description = product.Description,
            StockQuantity = product.StockQuantity,
            CategoryId = product.CategoryId,
            BrandId = product.BrandId,
            ImageUrl = product.ImageUrl,
            IsActive = product.IsActive
        };
        CartService.AddToCart(modelProduct);
    }

    // Local DTO Modelləri (Backend DTOları Application/DTOs'də var)
    public class BrandDto
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }

    public class CategoryDto
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }
}
