@page "/products"
@page "/products/{BrandId:int}"
@page "/wishlist"
@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CartService CartService
@inject WishlistService WishlistService
@inject ThemeService ThemeService
@implements IDisposable

<!-- ✨ TOAST BİLDİRİŞ ✨ -->
@if (showToast)
{
    <div class="toast-notification shadow-lg">
        <i class="bi bi-cart-check-fill me-2 fs-5"></i> @toastMessage
    </div>
}

<div class="container-fluid mt-2 mb-5 px-lg-5">
    
    <!-- 1. BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-4 shadow-sm border-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">Ana Səhifə</a></li>
            <li class="breadcrumb-item active">@(isWishlistMode ? "İstək Siyahısı" : "Oyuncaqlar")</li>
        </ol>
    </nav>

    <div class="row">
        <!-- 📂 2. SOL TƏRƏF: SÜZGƏC SİDEBAR (Step 1) -->
        <aside class="col-lg-3 pe-lg-4 mb-4">
            <div class="sticky-top" style="top: 90px;">
                <div class="card border-0 shadow-sm rounded-4 p-4 filter-sidebar">
                    <h5 class="fw-bold mb-4 d-flex align-items-center">
                        <i class="bi bi-sliders2-vertical me-2 text-primary"></i> Süzgəclər
                    </h5>

                    <!-- Axtarış -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold opacity-75">Məhsul Adı</label>
                        <div class="input-group input-group-sm bg-light rounded-pill px-2 border">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-transparent border-0 shadow-none"
                                   placeholder="Axtar..." @bind="searchText" @bind:event="oninput" @onchange="ApplyFilters" />
                        </div>
                    </div>

                    <!-- Qiymət -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold opacity-75">Qiymət Aralığı</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" class="form-control form-control-sm rounded-3" placeholder="Min" @bind="minPrice" />
                            <span class="text-muted">-</span>
                            <input type="number" class="form-control form-control-sm rounded-3" placeholder="Max" @bind="maxPrice" />
                        </div>
                        <button class="btn btn-outline-primary btn-sm w-100 mt-2 rounded-pill" @onclick="ApplyFilters">Tətbiq et</button>
                    </div>

                    <!-- Yaş Qrupu -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold opacity-75">Yaş Seçimi</label>
                        <div class="mt-2">
                            <div class="form-check mb-1 small">
                                <input class="form-check-input" type="checkbox" id="age1" @onchange="ApplyFilters">
                                <label class="form-check-label" for="age1">👶 0-3 Yaş</label>
                            </div>
                            <div class="form-check mb-1 small">
                                <input class="form-check-input" type="checkbox" id="age2" @onchange="ApplyFilters">
                                <label class="form-check-label" for="age2">🧒 3-6 Yaş</label>
                            </div>
                            <div class="form-check mb-1 small">
                                <input class="form-check-input" type="checkbox" id="age3" @onchange="ApplyFilters">
                                <label class="form-check-label" for="age3">🚀 6+ Yaş</label>
                            </div>
                        </div>
                    </div>

                    <!-- Sıralama -->
                    <div class="mb-2">
                        <label class="form-label small fw-bold opacity-75">Sıralama</label>
                        <select class="form-select form-select-sm rounded-3" @onchange="(ChangeEventArgs e) => { sortBy = e.Value.ToString(); ApplyFilters(); }">
                            <option value="name">Ada Görə (A-Z)</option>
                            <option value="price-asc">Ucuzdan Bahalıya</option>
                            <option value="price-desc">Bahalıdan Ucuza</option>
                        </select>
                    </div>
                </div>
            </div>
        </aside>

        <!-- 🧸 3. SAĞ TƏRƏF: MƏHSULLAR -->
        <main class="col-lg-9">
            <!-- Başlıq Hissəsi -->
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 border shadow-sm">
                <h3 class="fw-bold mb-0 fs-4">
                    @if (isWishlistMode)
                    {
                        <span class="text-danger"><i class="bi bi-heart-fill"></i> Sevdiklərim</span>
                    }
                    else
                    {

                        <span><i class="bi bi-grid-fill text-primary"></i> Məhsullar</span>
                    }
                </h3>
                <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill">
                    @filteredProducts?.Count məhsul tapıldı
                </span>
            </div>

            @if (allProducts == null)
            {
                <!-- SKELETON SCREEN -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm p-3 rounded-4">
                                <div class="skeleton mb-3" style="height: 200px; width: 100%;"></div>
                                <div class="skeleton mb-2" style="height: 20px; width: 80%;"></div>
                                <div class="skeleton" style="height: 40px; width: 100%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (filteredProducts.Count == 0)
            {
                <!-- EMPTY STATE -->
                <div class="text-center py-5 rounded-4 border bg-white shadow-sm mt-4">
                    <i class="bi bi-search-heart text-muted display-1 opacity-25"></i>
                    <h4 class="fw-bold mt-3">Heç bir oyuncaq tapılmadı</h4>
                    <button class="btn btn-primary mt-2 rounded-pill px-4" @onclick='() => NavManager.NavigateTo("/products")'>Hamısına bax</button>
                </div>
            }
            else
            {
                <!-- REAL MƏHSUL KARTLARI (Step 5: Animasiyalı) -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var item in filteredProducts)
                    {
                        <div class="col product-item-anim">
                            <div class="card h-100 shadow-sm border-0 product-card-modern overflow-hidden" @onclick='() => NavManager.NavigateTo($"/product/{item.Id}")'>
                                
                                <!-- Wishlist (Üst küncdə sabit) -->
                                <button class="modern-wishlist-btn" @onclick:stopPropagation="true" @onclick="() => HandleToggleWishlist(item)">
                                    <i class="bi @(WishlistService.IsInWishlist(item.Id) ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                                </button>

                                <div class="card-img-container p-4 d-flex align-items-center justify-content-center bg-light-soft">
                                    <img src="@item.ImageUrl" class="card-img-top img-fluid main-img" alt="@item.Name">
                                </div>

                                <div class="card-body p-4 d-flex flex-column">
                                    <h6 class="fw-bold text-truncate mb-2 text-dark">@item.Name</h6>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <span class="h5 mb-0 text-success fw-bold">@item.Price.ToString("0.00") AZN</span>
                                        <button class="btn btn-primary rounded-circle shadow p-0 d-flex align-items-center justify-content-center"
                                                style="width:40px; height:40px;" @onclick:stopPropagation="true" @onclick="() => AddToCart(item)">
                                            <i class="bi bi-cart-plus fs-5"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    [Parameter] public int? BrandId { get; set; }
    private List<ProductDto> allProducts;
    private List<ProductDto> filteredProducts;
    private string searchText = "";
    private decimal minPrice = 0;
    private decimal maxPrice = 5000;
    private string sortBy = "name";
    private bool showToast = false;
    private string toastMessage = "";
    private bool isWishlistMode = false;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += RefreshUI;
        WishlistService.OnWishlistChanged += RefreshUI;
        NavManager.LocationChanged += HandleLocationChanged;
        
        await LoadData();
        UpdateMode();
    }

    private void HandleLocationChanged(object sender, LocationChangedEventArgs e) { UpdateMode(); StateHasChanged(); }
    private void UpdateMode() { isWishlistMode = NavManager.Uri.ToLower().Contains("/wishlist"); ApplyFilters(); }

    private async Task LoadData()
    {
        try { allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("products"); }
        catch { allProducts = new(); }
    }

    private void RefreshUI() => InvokeAsync(StateHasChanged);

    private void HandleToggleWishlist(ProductDto p)
    {
        WishlistService.ToggleWishlist(p);
        if (isWishlistMode) ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allProducts == null) return;

        filteredProducts = allProducts
            .Where(p => p.IsActive)
            .Where(p => string.IsNullOrEmpty(searchText) || p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Where(p => p.Price >= minPrice && p.Price <= maxPrice)
            .Where(p => !isWishlistMode || WishlistService.IsInWishlist(p.Id))
            .Where(p => !BrandId.HasValue || p.BrandId == BrandId.Value)
            .ToList();

        if (sortBy == "price-asc") filteredProducts = filteredProducts.OrderBy(p => p.Price).ToList();
        else if (sortBy == "price-desc") filteredProducts = filteredProducts.OrderByDescending(p => p.Price).ToList();
        else filteredProducts = filteredProducts.OrderBy(p => p.Name).ToList();
    }

    private async Task AddToCart(ProductDto product)
    {
        CartService.AddToCart(product);
        toastMessage = $"{product.Name} səbətə atıldı!";
        showToast = true; StateHasChanged();
        await Task.Delay(2500); showToast = false; StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= RefreshUI;
        WishlistService.OnWishlistChanged -= RefreshUI;
        NavManager.LocationChanged -= HandleLocationChanged;
    }
}