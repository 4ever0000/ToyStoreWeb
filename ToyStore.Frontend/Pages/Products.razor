@page "/products"
@page "/products/{BrandId:int}"
@page "/wishlist"
@using ToyStore.Frontend.Models
@using ToyStore.Frontend.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject CartService CartService
@inject WishlistService WishlistService
@inject ThemeService ThemeService
@implements IDisposable

<!-- ✨ TOAST BİLDİRİŞ ✨ -->
@if (showToast)
{
    <div class="toast-notification shadow-lg">
        <i class="bi bi-cart-check-fill me-2 fs-5"></i> @toastMessage
    </div>
}

<div class="container-fluid mt-2 mb-5 px-lg-5">
    <!-- Başlıq Hissəsi -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0">
                @if (isWishlistMode)
                {
                    <i class="bi bi-heart-fill text-danger me-2"></i> <span>Seçilmiş Oyuncaqlar</span>
                }
                else
                {
                    <i class="bi bi-shop text-primary me-2"></i> <span>@(BrandId.HasValue ? "Brend Məhsulları" : "Bütün Oyuncaqlar")</span>
                }
            </h2>
            @if (isWishlistMode || BrandId.HasValue)
            {
                <button class="btn btn-link p-0 text-muted mt-1 text-decoration-none shadow-none" @onclick='() => NavManager.NavigateTo("/products")'>
                    <i class="bi bi-arrow-left"></i> Bütün məhsullara qayıt
                </button>
            }
        </div>
        <div class="text-end">
            <span class="badge rounded-pill bg-primary px-3 py-2 fs-6 shadow-sm">
                Cəmi: <b>@(filteredProducts?.Count ?? 0)</b> məhsul
            </span>
        </div>
    </div>

    <!-- 🔍 FİLTRLƏR (Dark Mode uyğun) 🔍 -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-5 filter-card border">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold small opacity-75">Axtarış</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" class="form-control border-start-0 shadow-none bg-transparent" 
                           placeholder="Oyuncaq adı..." @bind="searchText" @bind:event="oninput" @onchange="ApplyFilters" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small opacity-75">Qiymət (AZN)</label>
                <div class="input-group">
                    <input type="number" class="form-control shadow-none bg-transparent" placeholder="Min" @bind="minPrice" />
                    <span class="input-group-text bg-transparent border-0 px-1">-</span>
                    <input type="number" class="form-control shadow-none bg-transparent" placeholder="Max" @bind="maxPrice" />
                    <button class="btn btn-primary px-3" @onclick="ApplyFilters"><i class="bi bi-funnel-fill"></i></button>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small">Sıralama</label>
                <select class="form-select shadow-none bg-transparent" @onchange="(ChangeEventArgs e) => { sortBy = e.Value.ToString(); ApplyFilters(); }">
                    <option value="name">Ada Görə (A-Z)</option>
                    <option value="price-asc">Ucuzdan Bahalıya</option>
                    <option value="price-desc">Bahalıdan Ucuza</option>
                </select>
            </div>
        </div>
    </div>

    @if (allProducts == null)
    {
        <div class="text-center py-5"><div class="spinner-grow text-primary"></div><p class="mt-2 text-muted">Məhsullar gətirilir...</p></div>
    }
    else if (filteredProducts.Count == 0)
    {
        <div class="alert alert-info text-center py-5 rounded-4 border-0 shadow-sm">
            <i class="bi bi-emoji-frown fs-1 d-block mb-3"></i>
            <h5>@(isWishlistMode ? "Seçilmiş məhsulunuz yoxdur." : "Heç bir oyuncaq tapılmadı.")</h5>
            <button class="btn btn-primary mt-2 rounded-pill px-4" @onclick='() => NavManager.NavigateTo("/products")'>Mağazaya qayıt</button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var item in filteredProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card overflow-hidden" @onclick='() => NavManager.NavigateTo($"/product/{item.Id}")'>
                        
                        <button class="wishlist-btn" @onclick:stopPropagation="true" @onclick="() => HandleToggleWishlist(item)">
                            <i class="bi @(WishlistService.IsInWishlist(item.Id) ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                        </button>

                        <div class="card-img-container p-4 d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                            <img src="@item.ImageUrl" class="card-img-top img-fluid" style="max-height:100%; object-fit:contain;" alt="@item.Name">
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h6 class="fw-bold text-truncate mb-3">@item.Name</h6>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                <span class="h5 mb-0 text-primary fw-bold">@item.Price.ToString("0.00") AZN</span>
                                <button class="btn btn-primary rounded-circle shadow" style="width:42px; height:42px;" @onclick:stopPropagation="true" @onclick="() => AddToCart(item)">
                                    <i class="bi bi-cart-plus fs-5"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? BrandId { get; set; }
    private List<ProductDto> allProducts;
    private List<ProductDto> filteredProducts;
    private string searchText = "";
    private decimal minPrice = 0;
    private decimal maxPrice = 5000;
    private string sortBy = "name";
    private bool showToast = false;
    private string toastMessage = "";
    private bool isWishlistMode = false;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += RefreshUI;
        WishlistService.OnWishlistChanged += RefreshUI;
        
        // 🛑 Naviqasiya dəyişəndə səhifəni məcburi yenilə
        NavManager.LocationChanged += HandleLocationChanged;
        
        await LoadData();
        UpdateMode();
    }

    protected override void OnParametersSet()
    {
        UpdateMode();
    }

    private void HandleLocationChanged(object sender, LocationChangedEventArgs e)
    {
        UpdateMode();
        StateHasChanged();
    }

    private void UpdateMode()
    {
        isWishlistMode = NavManager.Uri.ToLower().Contains("/wishlist");
        ApplyFilters();
    }

    private async Task LoadData()
    {
        try {
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("products");
        } catch { allProducts = new(); }
    }

    private void RefreshUI() => InvokeAsync(StateHasChanged);

    private void HandleToggleWishlist(ProductDto p)
    {
        WishlistService.ToggleWishlist(p);
        if (isWishlistMode) ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allProducts == null) return;

        filteredProducts = allProducts
            .Where(p => p.IsActive)
            .Where(p => string.IsNullOrEmpty(searchText) || p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Where(p => p.Price >= minPrice && p.Price <= maxPrice)
            .Where(p => !isWishlistMode || WishlistService.IsInWishlist(p.Id))
            .Where(p => !BrandId.HasValue || p.BrandId == BrandId.Value)
            .ToList();

        if (sortBy == "price-asc") filteredProducts = filteredProducts.OrderBy(p => p.Price).ToList();
        else if (sortBy == "price-desc") filteredProducts = filteredProducts.OrderByDescending(p => p.Price).ToList();
        else filteredProducts = filteredProducts.OrderBy(p => p.Name).ToList();
    }

    private async Task AddToCart(ProductDto product)
    {
        CartService.AddToCart(product);
        toastMessage = $"{product.Name} səbətə atıldı!";
        showToast = true; StateHasChanged();
        await Task.Delay(2500); showToast = false; StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= RefreshUI;
        WishlistService.OnWishlistChanged -= RefreshUI;
        NavManager.LocationChanged -= HandleLocationChanged; // Unsubscribe
    }
}