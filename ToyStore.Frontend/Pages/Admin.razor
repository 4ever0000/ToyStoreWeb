@page "/admin"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-shield-lock"></i> Admin Paneli</h2>
        <button class="btn btn-success rounded-pill" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Yeni Məhsul
        </button>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <table class="table table-hover mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Şəkil</th>
                    <th>Ad</th>
                    <th>Qiymət</th>
                    <th>Brend</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @if (products == null)
                {
                    <tr><td colspan="5" class="text-center p-5">Yüklənir...</td></tr>
                }
                else
                {
                    @foreach (var p in products)
                    {
                        <tr>
                            <td><img src="@p.ImageUrl" width="40" height="40" class="rounded shadow-sm"></td>
                            <td>@p.Name</td>
                            <td>@p.Price AZN</td>
                            <td>@p.BrandId</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-2"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProduct(p.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ProductDto> products;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await Http.GetFromJsonAsync<List<ProductDto>>("products");
    }

    private async Task DeleteProduct(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Bu məhsulu silməyə əminsiniz?");
        if (confirmed)
        {
            // await Http.DeleteAsync($"products/{id}"); // API-da varsa aktiv et
            products.RemoveAll(x => x.Id == id); // Vizual olaraq sil
        }
    }

    private void OpenAddModal()
    {
        // Bura Yeni məhsul əlavə etmək üçün modal açılacaq
    }
}